LAPLACE_APP_NAME="Laplace's Demon"
LAPLACE_ENVIRONMENT=development
LAPLACE_LOG_LEVEL=INFO

# --- LLM (Sprint 2) ---
# Provider: mock (offline) | gemini | openai | groq | bai | router9 (local)
LAPLACE_LLM_PROVIDER=mock
# Override model chung; để trống dùng model mặc định của provider
LAPLACE_LLM_MODEL=
# Gemini free tier: lấy key tại https://aistudio.google.com/apikey
LAPLACE_GEMINI_API_KEY=
LAPLACE_OPENAI_API_KEY=
LAPLACE_GROQ_API_KEY=
# B.AI OpenAI-compatible API: https://api.b.ai/v1
LAPLACE_BAI_API_KEY=
# 9Router local: copy API key từ http://127.0.0.1:20128/dashboard
LAPLACE_ROUTER9_API_KEY=

# --- Lưu trữ ---
LAPLACE_DATABASE_URL=sqlite:///laplace.db
# Ngân sách ký tự context do ứng dụng dựng (không phải hard token limit)
LAPLACE_CONTEXT_MAX_CHARS=12000

# --- Core tools (Sprint 4) ---
# Tavily key: https://app.tavily.com/home
LAPLACE_TAVILY_API_KEY=
LAPLACE_HTTP_TIMEOUT_SECONDS=10
LAPLACE_WEB_MAX_RESULTS=5
LAPLACE_WEB_MAX_CHUNKS=3
LAPLACE_DOCUMENT_MAX_BYTES=10485760
LAPLACE_DOCUMENT_MAX_UNITS=200
LAPLACE_DOCUMENT_UNIT_MAX_CHARS=4000
LAPLACE_DOCUMENT_FULL_SUMMARY_MAX_CHARS=4000
LAPLACE_DOCUMENT_PARSE_TIMEOUT_SECONDS=10
LAPLACE_DOCUMENT_PARSER_MEMORY_MB=256
LAPLACE_DOCUMENT_MAX_EXPANDED_BYTES=52428800
LAPLACE_DOCUMENT_MAX_ZIP_ENTRIES=1000
# IANA timezone used to interpret reminder dates
LAPLACE_TIMEZONE=Asia/Ho_Chi_Minh
LAPLACE_REMINDER_SCAN_INTERVAL_SECONDS=1
LAPLACE_REMINDER_MISFIRE_GRACE_SECONDS=3600
LAPLACE_REMINDER_MAX_HORIZON_DAYS=365
LAPLACE_REMINDER_MAX_ATTEMPTS=3
LAPLACE_REMINDER_SEND_TIMEOUT_SECONDS=10
LAPLACE_REMINDER_BATCH_SIZE=25
LAPLACE_REMINDER_MAX_CONCURRENCY=5

# --- Telegram (Sprint 2) ---
# Tạo bot với @BotFather trên Telegram rồi dán token vào đây
LAPLACE_TELEGRAM_BOT_TOKEN=
